{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rememberme-lookup",
  "account_id": "5c11819c6fdb08421e6d58084e37f028",
  "main": "index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vpc_services": [
    {
      "binding": "LOOKUP_SERVICE",
      "service_id": "01a18092-88b0-7d51-899f-7dddc223daf1"
    }
  ],
  "ratelimits": [
    {
      "name": "LOOKUP_RATE",
      "namespace_id": "21001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
