[Unit]
Description=Remember Me temporary HTTPS lookup tunnel
After=network-online.target rememberme-lookup-bridge.service
Wants=network-online.target
Requires=rememberme-lookup-bridge.service

[Service]
Type=simple
User=rememberme
Group=rememberme
WorkingDirectory=/opt/rememberme/temporary
ExecStart=/opt/rememberme/temporary/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8788
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target
