# Add a separate site after selecting a domain and obtaining its certificate.
server {
    listen 443 ssl;
    server_name configure-before-deploy.invalid;
    ssl_certificate /etc/rememberme/tls/fullchain.pem;
    ssl_certificate_key /etc/rememberme/tls/privkey.pem;
    client_max_body_size 256k;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 25s;
    }
}
