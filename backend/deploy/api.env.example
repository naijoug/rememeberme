ENVIRONMENT=production
PUBLIC_ORIGIN=https://configure-before-deploy.invalid
PORT=8787
DATABASE_PATH=/var/lib/rememberme/rememberme.sqlite
TRUST_LOOPBACK_PROXY=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NATIVE_CALLBACKS=rememberme://auth/callback
CLIENT_ORIGINS=
# Set hermes to roll back to the retained isolated translation service.
TRANSLATION_PROVIDER=magpie
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
# Loopback app label; for remote Magpie use a private gateway key instead.
MAGPIE_API_KEY=magpie-rememberme
MAGPIE_MODEL=zhipu/glm-5.3-flash
HERMES_BASE_URL=http://127.0.0.1:8643/v1
HERMES_API_KEY=
HERMES_MODEL=rememberme-translation
# Server-side MyMemory fallback; false disables fallback for the selected primary provider.
MYMEMORY_ENABLED=true
