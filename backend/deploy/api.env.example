ENVIRONMENT=production
PUBLIC_ORIGIN=https://configure-before-deploy.invalid
PORT=8787
DATABASE_PATH=/var/lib/rememberme/rememberme.sqlite
TRUST_LOOPBACK_PROXY=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NATIVE_CALLBACKS=rememberme://auth/callback
CLIENT_ORIGINS=
HERMES_BASE_URL=http://127.0.0.1:8643/v1
HERMES_API_KEY=
HERMES_MODEL=rememberme-translation
# Server-side MyMemory fallback; false keeps translation Hermes-only.
MYMEMORY_ENABLED=true
