{
  "name": "remember-me-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "types": "wrangler types worker-configuration.d.ts --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:native": "node scripts/verify-native-sync.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "build": "wrangler deploy --env \"\" --dry-run --outdir .build"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261009.1",
    "@msw/cloudflare": "0.2.0",
    "@types/node": "22.20.5",
    "miniflare": "5.20261006.1-alpha",
    "msw": "3.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
