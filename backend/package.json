{
  "name": "remember-me-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.3"
  },
  "scripts": {
    "dev": "npm run build && node .build/server.mjs",
    "types": "wrangler types worker-configuration.d.ts --strict-vars=false",
    "typecheck": "tsc -p tsconfig.node.json",
    "test": "vitest run --config vitest.node.config.ts",
    "test:native": "node scripts/verify-native-sync.mjs",
    "test:browser": "node scripts/verify-browser-sync.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "package:deploy": "npm run build && node scripts/package-deploy.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "build": "node scripts/build-node.mjs",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build:worker": "wrangler deploy --env \"\" --dry-run --outdir .build",
    "test:worker": "vitest run",
    "typecheck:worker": "tsc --noEmit",
    "cf:check": "node scripts/cloudflare.mjs check",
    "cf:deploy": "node scripts/cloudflare.mjs deploy",
    "test:cloudflare": "node --test scripts/cloudflare.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261009.1",
    "@msw/cloudflare": "0.2.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "msw": "3.0.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
