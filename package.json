{
  "name": "rememberme-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend/browser-extension"
  ],
  "scripts": {
    "dev": "npm --prefix frontend/browser-extension run dev",
    "dev:firefox": "npm --prefix frontend/browser-extension run dev:firefox",
    "build": "npm --prefix frontend/browser-extension run build",
    "build:firefox": "npm --prefix frontend/browser-extension run build:firefox",
    "zip": "npm --prefix frontend/browser-extension run zip",
    "zip:firefox": "npm --prefix frontend/browser-extension run zip:firefox",
    "compile": "npm --prefix frontend/browser-extension run compile",
    "test": "npm --prefix frontend/browser-extension test",
    "test:watch": "npm --prefix frontend/browser-extension run test:watch"
  }
}
