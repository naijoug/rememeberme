{
  "name": "remember-me",
  "description": "Look up English words as you read and keep a local vocabulary history of the words you forget.",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": "^22.22.3"
  },
  "scripts": {
    "dev": "wxt",
    "dev:local": "wxt --config wxt.feedback.config.ts --mode feedback",
    "local:start": "node scripts/local-feedback-service.mjs start",
    "local:stop": "node scripts/local-feedback-service.mjs stop",
    "local:status": "node scripts/local-feedback-service.mjs status",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "node scripts/package-release.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iconoir/vue": "^7.12.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.1.11",
    "@wxt-dev/module-vue": "^1.0.3",
    "fake-indexeddb": "6.2.4",
    "happy-dom": "^21.0.1",
    "typescript": "^5.9.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.6",
    "wxt": "^0.21.4"
  }
}
