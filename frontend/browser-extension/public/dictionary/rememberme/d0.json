{"make":{"schemaVersion":1,"word":"make","forms":["makes","made","making"],"senses":[{"id":"make:685a72524bf5a093","partOfSpeech":"verb","en":"to create or produce something","zh":"制造；制作；创造","example":{"en":"She made a cake for the party.","zh":"她为聚会做了一个蛋糕。"},"collocations":["make a cake","make a plan","make a list"]},{"id":"make:6cb016861fc8cf82","partOfSpeech":"verb","en":"to cause someone or something to be or do something","zh":"使；让；促使","example":{"en":"The news made her happy.","zh":"这个消息让她很开心。"},"collocations":["make someone happy","make it clear","make a difference"]},{"id":"make:38f5044628507537","partOfSpeech":"noun","en":"a brand or type of product","zh":"品牌；型号","example":{"en":"This is a famous make of car.","zh":"这是一款著名品牌的汽车。"},"collocations":["a car make","a famous make"]}],"contentHash":"3d6f030bbcae418d683dc18328731f0b51a492f5a6a5751f4e90b63997feb1bb","reviewStatus":"approved"},"signal":{"schemaVersion":1,"word":"signal","forms":["signals","signaled","signaling","signalled","signalling"],"senses":[{"id":"signal:7f072007f3cd4a8b","partOfSpeech":"noun","en":"a sound, action, or event that gives information or an instruction","zh":"信号；暗号","example":{"en":"The red light is a signal to stop.","zh":"红灯是停下的信号。"},"collocations":["traffic signal","warning signal","send a signal"]},{"id":"signal:6e513c157b34afc1","partOfSpeech":"noun","en":"electrical waves or data sent or received by a device","zh":"电信号；数据信号","example":{"en":"The phone lost its signal in the tunnel.","zh":"手机在隧道里失去了信号。"},"collocations":["weak signal","phone signal","digital signal"]},{"id":"signal:9445a0a481f04ca9","partOfSpeech":"verb","en":"to make a gesture or action to give information or an instruction","zh":"示意；发信号","example":{"en":"She signaled to the waiter for the bill.","zh":"她向服务员示意结账。"},"collocations":["signal to someone","signal for help","signal a turn"]},{"id":"signal:9f3a42573c52d9ee","partOfSpeech":"adjective","en":"important and noticeable","zh":"显著的；重大的","example":{"en":"The discovery was a signal achievement in medicine.","zh":"这一发现是医学上的一项重大成就。"},"collocations":["signal success","signal contribution"]}],"contentHash":"2c30e28069cd2c587e345e4986cbcc95150dfbe1818f833307ce74c50f5574b3","reviewStatus":"approved"},"lung":{"schemaVersion":1,"word":"lung","forms":["lungs"],"senses":[{"id":"lung:bb5f36e7df4677d3","partOfSpeech":"noun","en":"one of the two organs in the chest used for breathing","zh":"肺；肺部器官","example":{"en":"Smoking can damage your lungs.","zh":"吸烟会损害你的肺。"},"collocations":["lung cancer","lung disease","collapsed lung"]}],"contentHash":"b4268dba8d8e1346ec0a24a108f5dd4e5fa64278c42e2dc6c7125cbe75904cc1","reviewStatus":"approved"},"depend":{"schemaVersion":1,"word":"depend","forms":["depends","depended","depending"],"senses":[{"id":"depend:1770c9dd5d6506b8","partOfSpeech":"verb","en":"to be decided or affected by something","zh":"取决于；受……影响","example":{"en":"Success depends on careful preparation.","zh":"成功取决于认真准备。"},"collocations":["depend on","depend upon","depend heavily on"]},{"id":"depend:78b77116b3bdd9f8","partOfSpeech":"verb","en":"to rely on someone or something for support or help","zh":"依靠；依赖","example":{"en":"Young children depend on adults for care.","zh":"幼儿依靠成人照顾。"},"collocations":["depend on parents","depend on support"]},{"id":"depend:975dabc3a9e1a89c","partOfSpeech":"verb","en":"used to say that an answer is not fixed and varies by situation","zh":"视情况而定","example":{"en":"Are you coming? It depends.","zh":"你来吗？看情况。"},"collocations":["it depends","that depends"]}],"contentHash":"ec6f472efcf60d3cb9ce3bb908f50b6214e76b0ce2c511d486eb26859c765dae","reviewStatus":"approved"},"yourself":{"schemaVersion":1,"word":"yourself","forms":["yourselves"],"senses":[{"id":"yourself:94b007f944ea83ad","partOfSpeech":"pronoun","en":"Used as the object when the person spoken to is also the subject.","zh":"你自己（作宾语，指听话者本人）","example":{"en":"Did you hurt yourself?","zh":"你伤到自己了吗？"},"collocations":["hurt yourself","look after yourself","enjoy yourself"]},{"id":"yourself:32291ddc75f75d74","partOfSpeech":"pronoun","en":"Used to emphasize the person spoken to.","zh":"你本人；你自己（用于强调）","example":{"en":"You yourself said it was a bad idea.","zh":"你自己说过那是个坏主意。"},"collocations":["you yourself","yourself included"]},{"id":"yourself:a95f0132350aebca","partOfSpeech":"pronoun","en":"Used after “by” to mean alone or without help.","zh":"（用于 by 后）独自；靠自己","example":{"en":"Can you finish it by yourself?","zh":"你能自己完成吗？"},"collocations":["by yourself","all by yourself"]}],"contentHash":"e12737942d23ef7d6fb1b73bd482e4141a1286a48d78d5246a42914b3aed7c1a","reviewStatus":"approved"}}
