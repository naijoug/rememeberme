    {"type": "object", "additionalProperties": false, "required": ["deviceId", "revision"],
      "properties": {"deviceId": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}, "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}}
  ]
