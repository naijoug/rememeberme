{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rememberme:sync-responses-v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9:_-]+$"
        },
        "status": {
          "const": "applied"
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9:_-]+$"
            },
            "word": {
              "type": "string",
              "maxLength": 16384
            },
            "kind": {
              "enum": [
                "word",
                "phrase",
                "abbreviation",
                "proper_noun"
              ]
            },
            "count": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "definition": {
              "type": "object",
              "required": [
                "word",
                "phonetics",
                "meanings"
              ],
              "properties": {
                "word": {
                  "type": "string",
                  "maxLength": 16384
                },
                "phonetics": {
                  "type": "array"
                },
                "meanings": {
                  "type": "array"
                }
              }
            },
            "notes": {
              "type": "string",
              "maxLength": 16384
            },
            "createdAtMs": {
              "type": "number",
              "minimum": 0
            },
            "updatedAtMs": {
              "type": "number",
              "minimum": 0
            },
            "normalizedKey": {
              "type": "string",
              "maxLength": 16384
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "deleted": {
              "type": "boolean"
            },
            "review": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "algorithmVersion": {
                      "const": "review-v1"
                    },
                    "step": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "dueAtMs": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "algorithmVersion",
                    "step",
                    "dueAtMs"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "reviewVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "historyOrdering": {
              "enum": [
                "retained",
                "timestamp"
              ]
            }
          },
          "required": [
            "id",
            "word",
            "kind",
            "count",
            "definition",
            "notes",
            "createdAtMs",
            "updatedAtMs",
            "normalizedKey",
            "version",
            "deleted",
            "review",
            "reviewVersion"
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "operationId",
        "status",
        "entry",
        "cursor"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "requestId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "code",
            "retryable",
            "requestId"
          ]
        }
      },
      "required": [
        "error"
      ]
    }
  ]
}
